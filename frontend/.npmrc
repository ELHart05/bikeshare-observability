# Resolve peer dependencies in legacy mode.
#
# WHY. The npm 10.9.3 resolver fails on this project's tree while
# resolving vitest's peer dependencies:
#
#     npm error Cannot read properties of null (reading 'edgesOut')
#
# This is an npm bug, not a project issue.
# Legacy mode skips that step,
# and the committed package-lock.json was produced in this mode.
# "npm ci" requires the two to be consistent, and would not be without this line.
#
# In practice: "npm ci" and "npm install" work as is, with no flag to remember.
legacy-peer-deps=true